  "authors": [
    "Joaquin (Pato) Decima <jdecima@vasak.net.ar>"
  ],
  "description": "The VasakOS contextual menu: one look and one behaviour for every right click.",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
