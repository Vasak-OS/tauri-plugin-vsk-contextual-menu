    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.4.0",
    "rollup": "^4.59.0",
    "tslib": "^2.8.1",
